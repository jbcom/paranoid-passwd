{
  "name": "paranoid-passwd-docs",
  "private": true,
  "version": "0.0.0",
  "description": "Sourcey documentation toolchain for paranoid-passwd.",
  "scripts": {
    "build": "sourcey build && mkdir -p dist/assets && cp -R assets/. dist/assets/ && cp public/install.sh dist/install.sh && cp public/CNAME dist/CNAME",
    "dev": "sourcey dev",
    "validate": "pnpm run build && bash ../scripts/validate_sourcey_output.sh"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "sourcey": "3.6.5"
  }
}
